{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(pwd)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(php -l:*)",
      "Bash(vendor/bin/phpcs:*)",
      "Bash(vendor/bin/phpcbf:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(composer:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(wp:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git tag:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref:*)",
      "Bash(git gc:*)",
      "Bash(gh:*)",

      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(unlink:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(find:*-delete*)",
      "Bash(find:*-exec rm*)",
      "Bash(xargs rm:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",

      "Bash(wp db:*)",
      "Bash(wp eval:*)",
      "Bash(wp eval-file:*)",
      "Bash(wp shell:*)",
      "Bash(wp config:*)",
      "Bash(wp user:*)",
      "Bash(wp package:*)",
      "Bash(wp core:*)",
      "Bash(wp plugin install:*)",
      "Bash(wp plugin update:*)",
      "Bash(wp plugin delete:*)",
      "Bash(wp plugin uninstall:*)",
      "Bash(wp theme:*)",
      "Bash(wp site empty:*)",
      "Bash(wp site delete:*)",
      "Bash(wp post delete:*)",
      "Bash(wp option delete:*)",
      "Bash(wp transient delete:*)",
      "Bash(wp search-replace:*)",
      "Bash(mysql:*)",
      "Bash(mysqldump:*)",
      "Bash(mariadb:*)",

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(snap:*)",
      "Bash(systemctl:*)",
      "Bash(service:*)",
      "Bash(crontab:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ftp:*)",
      "Bash(rsync:*)",

      "Bash(eval:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(base64 -d:*)",
      "Bash(base64 --decode:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(php -r:*)",
      "Bash(node -e:*)",
      "Bash(npx -y:*)",

      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(npm i -g:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm config:*)",
      "Bash(composer global:*)",
      "Bash(composer config:*)",
      "Bash(composer remove:*)",

      "Bash(powershell.exe:*)",
      "Bash(pwsh.exe:*)",
      "Bash(cmd.exe:*)",
      "Bash(wsl.exe:*)",
      "Bash(explorer.exe:*)",

      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(cat .env:*)",
      "Bash(cat wp-config.php:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/wp-config.php)",
      "Read(**/wp-config-*.php)",
      "Read(**/*.sql)",
      "Read(**/*.sql.gz)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/auth.json)",
      "Read(**/.npmrc)",
      "Read(**/.htpasswd)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/composer/auth.json)",
      "Read(~/.composer/auth.json)",
      "Read(~/.git-credentials)",
      "Read(~/.bash_history)",
      "Read(//mnt/**)",
      "Read(//etc/shadow)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/wp-config.php)",
      "Edit(./.git/**)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./deny.md)",
      "Edit(./vendor/**)",
      "Edit(./node_modules/**)",
      "Edit(./build/**)",
      "Edit(./.github/workflows/**)",
      "Edit(~/**)",
      "Edit(//mnt/**)",
      "Edit(//etc/**)",
      "Write(./.env)",
      "Write(./.git/**)",
      "Write(./.claude/**)",
      "Write(./CLAUDE.md)",
      "Write(./deny.md)",
      "Write(./vendor/**)",
      "Write(./node_modules/**)",
      "Write(//mnt/**)",
      "Write(~/**)"
    ]
  }
}
